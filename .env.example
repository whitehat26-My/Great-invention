# Copy to .env and adjust. Every value here has a working default in config.py,
# so an empty .env still runs the full simulated platform.

RESTAURANT_NAME="The Great Invention"
TIMEZONE=Asia/Kuala_Lumpur
CURRENCY=MYR

# --- Postgres (ports match scripts/dev_up.sh and docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
POSTGRES_DB=restaurant_ai

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# --- LLM ---
# fake      = deterministic scripted model; no API key, no network. Used by tests.
# anthropic = live Claude models; requires ANTHROPIC_API_KEY.
# google    = live Gemini models; requires GOOGLE_API_KEY (free, no card, from
#             https://aistudio.google.com).
LLM_PROVIDER=fake

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-opus-5
MODEL_CONVERSATIONAL=claude-sonnet-5

# --- Google ---
# Both tiers are Flash because the free tier covers Flash and Flash-Lite only.
# With billing attached, point the reasoning tier at a Pro model.
# They are different Flash models on purpose: the free-tier quota is 5 requests
# a minute *per model*, so sharing one id makes the 13 agents queue for nothing.
# `restaurant-ai models` lists what your key can actually see — ids move (Flash
# went 3.0 to 3.7 inside a year) and the `-latest` aliases are not safe to pin
# to; one of them resolved to a deprecated model and returned a bare 404.
GOOGLE_API_KEY=
GOOGLE_MODEL_REASONING=gemini-3.6-flash
GOOGLE_MODEL_CONVERSATIONAL=gemini-3.5-flash
# Gemini 3 dropped thinking_budget for a thinking level: minimal|low|medium|high.
# Unset leaves the model on its own default.
GOOGLE_REASONING_EFFORT=
# --- Shared ---
# Thinking is drawn from the same budget, so this covers reasoning + answer.
LLM_MAX_TOKENS=8192
# A rate-limited provider is a queue, not an error. The client defaults give up
# after about half the wait a free tier asks for, which fails the run.
LLM_MAX_RETRIES=10
# That patience is right for a scheduled run and wrong for anything a person is
# waiting on: a chat that sits in backoff for minutes is indistinguishable from
# a dead bot. The question desk uses these instead.
LLM_INTERACTIVE_MAX_RETRIES=1
LLM_INTERACTIVE_TIMEOUT=25
# Anthropic only; Gemini spells it GOOGLE_REASONING_EFFORT above.
# adaptive = the model decides how hard to think per request. disabled = off.
# off = send no thinking field at all, which is what a pre-4.6 model needs.
LLM_THINKING=adaptive
# Deliberately unset. Opus 5 and Sonnet 5 removed the sampling parameters and
# reject a request that carries one, so sending temperature=0 — the obvious
# default for an operations system that wants repeatable answers — is a 400 on
# every call. Set it only against a model old enough to accept it.
# LLM_TEMPERATURE=0.0

# --- Integration providers: fake | live ---
POS_PROVIDER=fake
MESSAGING_PROVIDER=fake
REVIEWS_PROVIDER=fake
SUPPLIER_PROVIDER=fake
SOCIAL_PROVIDER=fake
PAYROLL_PROVIDER=fake
BANK_PROVIDER=fake

# --- Webhook signature verification ---
WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- Human approval: slack | telegram | none ---
APPROVAL_CHANNEL=none
APPROVAL_VALUE_THRESHOLD=250.00
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#restaurant-approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only needed for the webhook path. Telegram echoes it in
# X-Telegram-Bot-Api-Secret-Token, and it is the only thing separating Telegram
# from anyone else who finds the URL. Unset closes the endpoint rather than
# opening it. `telegram-listen` needs no public URL and no secret.
TELEGRAM_WEBHOOK_SECRET=
# Guards GET /approvals, POST /approvals/{id}/resolve and POST /agents/{n}/run.
# Unset closes them. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
APPROVAL_API_KEY=

# --- Operating policy ---
SERVICE_LEVEL_Z=1.65
PRICE_CHANGE_MAX_PCT=0.10
PRICE_CHANGE_COOLDOWN_DAYS=14
MIN_GROSS_MARGIN_PCT=0.55
INVOICE_PRICE_TOLERANCE_PCT=0.02
REENGAGEMENT_DORMANT_DAYS=45
ESCALATE_REVIEW_AT_OR_BELOW=2

LOG_LEVEL=INFO
LOG_JSON=false
