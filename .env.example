# Copy to .env and adjust. Every value here has a working default in config.py,
# so an empty .env still runs the full simulated platform.

RESTAURANT_NAME="The Great Invention"
TIMEZONE=Asia/Kuala_Lumpur
CURRENCY=MYR

# --- Postgres (ports match scripts/dev_up.sh and docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
POSTGRES_DB=restaurant_ai

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# --- LLM ---
# fake      = deterministic scripted model; no API key, no network. Used by tests.
# anthropic = live models; requires ANTHROPIC_API_KEY.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-opus-5
MODEL_CONVERSATIONAL=claude-sonnet-5

# --- Integration providers: fake | live ---
POS_PROVIDER=fake
MESSAGING_PROVIDER=fake
REVIEWS_PROVIDER=fake
SUPPLIER_PROVIDER=fake
SOCIAL_PROVIDER=fake
PAYROLL_PROVIDER=fake
BANK_PROVIDER=fake

# --- Webhook signature verification ---
WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- Human approval: slack | telegram | none ---
APPROVAL_CHANNEL=none
APPROVAL_VALUE_THRESHOLD=250.00
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#restaurant-approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Operating policy ---
SERVICE_LEVEL_Z=1.65
PRICE_CHANGE_MAX_PCT=0.10
PRICE_CHANGE_COOLDOWN_DAYS=14
MIN_GROSS_MARGIN_PCT=0.55
INVOICE_PRICE_TOLERANCE_PCT=0.02
REENGAGEMENT_DORMANT_DAYS=45
ESCALATE_REVIEW_AT_OR_BELOW=2

LOG_LEVEL=INFO
LOG_JSON=false
